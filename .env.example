# Docker Compose: host address and port published on the server computer.
# 0.0.0.0 accepts connections to 192.168.0.7 and the router's forwarded traffic.
BIND_ADDRESS=0.0.0.0
PORT=7175

# Direct Node execution: HOST is read from the process environment.
# npm start does not automatically load this file.
HOST=0.0.0.0
